# EVENTLINE Lokale KI — Speicherprofil (Masterplan E2.0): eine Messzeile pro Aufruf, nur Zahlen.
# Gestartet von eventline-ki-speicherprofil.timer (jede Minute). Installiert von install.sh.
# Liest Trust one nur (memory.current), konfiguriert dort nichts.

[Unit]
Description=EVENTLINE Lokale KI — Speicherprofil (eine Messzeile)
ConditionPathIsMountPoint=/srv/eventline-ki/data

[Service]
Type=oneshot
ExecStart=/bin/bash /srv/eventline-ki/repo/eventline-ki/messung/speicherprofil.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=50
