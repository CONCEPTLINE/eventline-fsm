# EVENTLINE Rig — aus 99-openlinkhub.rules von OpenLinkHub 0.9.2, nur die Zeile für den iCUE LINK System Hub
# (1b1c:0c3f). Bewusst NICHT übernommen: die übrigen ~190 Corsair-Geräte und die uinput-Regel (Tastatur-/Maus-
# Nachbildung — braucht der Rig nicht). Installiert von kuehlung/install.sh nach /etc/udev/rules.d/.
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c3f", MODE="0660", OWNER="openlinkhub"
